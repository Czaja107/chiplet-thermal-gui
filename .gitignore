# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments (run_gui.bat creates .venv here)
.venv/
venv/
env/

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Simulation output. Runs are reproducible from a saved design, and each run
# folder holds ~1 MB of HotSpot grids, so they do not belong in the history.
gui_runs/
*.grid
*.steady
*.sha256

# ...but the challenge package ships reference results that must stay.
!chiplet_thermal_continuous/example_outputs/**
!chiplet_thermal_continuous/random_example/**

# HotSpot build artefacts, in case a checkout is placed inside this tree
hotspot
hotspot.exe
*.o
*.a

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Optimizer output while a run is in progress, and the demo's HotSpot cache.
# Commit a finished results/optimize_<material>/submission.json deliberately.
results_opt_*.log
results/optimize_*/
results/demo_cache/
